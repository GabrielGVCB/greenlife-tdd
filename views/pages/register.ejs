<div class="container mt-5 mb-5">
	<div class="row justify-content-center">
		<div class="col-md-7 col-lg-6">
			<div class="auth-card">
				<div class="auth-header">
					<h2 class="fw-bold mb-1">Crie sua conta</h2>
					<p class="mb-0" style="opacity:.85;">Pequenos gestos, grande impacto.</p>
				</div>
				<div class="p-4">
					<form action="/register" method="POST">
						<div class="row g-3 mb-3">
							<div class="col-md-6">
								<label for="username" class="form-label">Usuário</label>
								<input type="text" class="form-control" id="username" name="username"
									placeholder="ex: mariaverde" required minlength="3" maxlength="30" />
							</div>
							<div class="col-md-6">
								<label for="fullName" class="form-label">Nome completo</label>
								<input type="text" class="form-control" id="fullName" name="fullName"
									placeholder="Maria Silva" required />
							</div>
						</div>
						<div class="mb-3">
							<label for="email" class="form-label">E-mail</label>
							<input type="email" class="form-control" id="email" name="email"
								placeholder="seu@email.com" required />
						</div>
						<div class="row g-3 mb-3">
							<div class="col-md-6">
								<label for="password" class="form-label">Senha</label>
								<input type="password" class="form-control" id="password" name="password"
									placeholder="Mínimo 8 caracteres" required minlength="8" />
							</div>
							<div class="col-md-6">
								<label for="confirmPassword" class="form-label">Confirmar senha</label>
								<input type="password" class="form-control" id="confirmPassword"
									name="confirmPassword" placeholder="Repita a senha" required minlength="8" />
							</div>
						</div>
						<small class="text-muted d-block mb-3">
							<i class="bi bi-shield-check me-1"></i>
							Sua senha é armazenada com criptografia bcrypt e nunca em texto plano.
						</small>
						<div class="d-grid gap-2 mb-3">
							<button type="submit" class="btn btn-primary btn-lg">Criar conta</button>
						</div>
						<p class="text-center text-muted mb-0">
							Já tem conta?
							<a href="/login" class="text-primary-green fw-bold text-decoration-none">Fazer login</a>
						</p>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
