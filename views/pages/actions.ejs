<div class="container py-4">
	<div class="row g-4">
		<div class="col-lg-4">
			<div class="impact-box">
				<div class="label">Seu impacto total</div>
				<div class="val"><%= totalImpact %><sup>kg CO₂</sup></div>
				<p class="small mt-3 mb-0" style="opacity:.8;">
					Baseado em <strong><%= count %></strong> ação<%= count === 1 ? '' : 'ões' %> registrada<%= count === 1 ? '' : 's' %>.
				</p>
				<a href="/actions/new" class="btn btn-sm mt-3" style="background:var(--accent);color:var(--ink);font-weight:600;">
					<i class="bi bi-plus-circle me-1"></i> Registrar nova ação
				</a>
			</div>
		</div>

		<div class="col-lg-8">
			<h2 class="fw-bold mb-3">Minhas ações sustentáveis</h2>
			<% if (actions && actions.length > 0) { %>
				<% actions.forEach(function(a) { %>
					<div class="tip-card p-3 mb-3">
						<div class="d-flex justify-content-between align-items-start gap-3">
							<div>
								<h6 class="fw-bold mb-1"><%= a.title %></h6>
								<% if (a.category) { %>
									<span class="cat-chip"><%= a.category.name %></span>
								<% } %>
								<% if (a.description) { %>
									<p class="text-muted small mt-2 mb-1"><%= a.description %></p>
								<% } %>
								<small class="text-muted">
									<i class="bi bi-calendar me-1"></i>
									<%= new Date(a.createdAt).toLocaleDateString('pt-BR') %>
								</small>
							</div>
							<div class="text-end">
								<div class="fw-bold text-primary-green" style="font-family:'Fraunces',serif; font-size:1.2rem;">
									-<%= a.impactKgCO2 %> <small>kg CO₂</small>
								</div>
								<form action="/actions/<%= a.id %>/delete" method="POST" class="mt-2">
									<button type="submit" class="btn btn-sm btn-link text-muted"
										onclick="return confirm('Remover ação?');">
										<i class="bi bi-trash"></i>
									</button>
								</form>
							</div>
						</div>
					</div>
				<% }); %>
			<% } else { %>
				<div class="text-center text-muted py-5">
					<i class="bi bi-tree display-4 d-block mb-3 text-primary-green"></i>
					<p>Você ainda não registrou nenhuma ação.</p>
					<a href="/actions/new" class="btn btn-primary mt-2">Registrar primeira ação</a>
				</div>
			<% } %>
		</div>
	</div>
</div>
