<div class="container py-4">
	<h2 class="fw-bold mb-4"><i class="bi bi-star-fill text-primary-green me-2"></i>Meus favoritos</h2>

	<% if (favorites && favorites.length > 0) { %>
		<div class="row g-3">
			<% favorites.forEach(function(f) { %>
				<% if (f.Tip) { %>
					<div class="col-md-6 col-lg-4">
						<a href="/tip/<%= f.Tip.id %>" class="text-decoration-none">
							<div class="tip-card h-100 p-3">
								<% if (f.Tip.category) { %>
									<span class="cat-chip mb-2"><%= f.Tip.category.name %></span>
								<% } %>
								<h6 class="fw-bold text-dark mt-2 mb-1"><%= f.Tip.title %></h6>
								<% if (f.Tip.summary) { %>
									<p class="text-muted small mb-0"><%= f.Tip.summary %></p>
								<% } %>
							</div>
						</a>
					</div>
				<% } %>
			<% }); %>
		</div>
	<% } else { %>
		<div class="text-center text-muted py-5">
			<i class="bi bi-star display-4 d-block mb-3"></i>
			<p>Você ainda não favoritou nenhuma dica.</p>
			<a href="/home" class="btn btn-primary mt-2">Explorar dicas</a>
		</div>
	<% } %>
</div>
