<!-- Hero -->
<header class="hero-section">
	<div class="container position-relative" style="z-index:2;">
		<h1 class="display-3 fw-bold mb-3">
			Pequenos gestos,<br><em>grande impacto.</em>
		</h1>
		<p class="lead mb-4" style="max-width:640px; margin: 0 auto; opacity:.85;">
			Aprenda práticas sustentáveis, registre suas ações ecológicas e inspire
			a comunidade com suas experiências.
		</p>
		<div class="d-flex justify-content-center gap-3 mt-4">
			<a href="/register" class="btn btn-primary btn-lg px-5">Começar agora</a>
			<a href="#destaques" class="btn btn-outline-light btn-lg px-5">Explorar</a>
		</div>
	</div>
</header>

<!-- Categorias em destaque -->
