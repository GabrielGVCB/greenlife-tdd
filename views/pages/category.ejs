<div class="container-fluid px-lg-4">
	<div class="row">
		<%- include("../partials/sidebar") %>

		<main class="col-12 col-md-9 col-lg-10 py-4">
			<!-- Breadcrumb -->
			<nav aria-label="breadcrumb" class="mb-3 small">
				<ol class="breadcrumb">
					<li class="breadcrumb-item"><a href="/home" class="text-muted text-decoration-none">Início</a></li>
					<li class="breadcrumb-item active" aria-current="page"><%= category.name %></li>
				</ol>
			</nav>

			<!-- Header da categoria -->
			<div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3 pb-3" style="border-bottom:1px solid var(--line);">
				<div>
					<h1 class="display-5 fw-bold mb-1">
						<i class="bi <%= category.icon || 'bi-leaf' %> me-2" style="color: <%= category.color %>;"></i>
						<%= category.name %>
					</h1>
					<% if (category.description) { %>
						<p class="text-muted mb-0"><%= category.description %></p>
					<% } %>
				</div>
				<a href="/community" class="btn btn-outline-primary">
					<i class="bi bi-people me-1"></i> Ver posts da comunidade
				</a>
			</div>

			<div class="row g-4">
				<!-- Coluna de dicas -->
				<div class="col-lg-8">
					<h5 class="fw-bold mb-3">Dicas oficiais</h5>
					<% if (tips && tips.length > 0) { %>
						<% tips.forEach(function(tip) { %>
							<div class="tip-card p-3 mb-3 d-flex gap-3 align-items-start">
								<div class="tip-thumb cat-<%= category.slug %>" style="min-width:100px; width:100px; height:100px;">
									<i class="bi <%= category.icon %>" style="font-size:2rem;"></i>
								</div>
								<div class="flex-grow-1">
									<h6 class="fw-bold mb-1">
										<a href="/tip/<%= tip.id %>" class="text-decoration-none text-dark"><%= tip.title %></a>
									</h6>
									<% if (tip.summary) { %>
										<p class="text-muted small mb-2"><%= tip.summary %></p>
									<% } %>
									<div class="d-flex gap-3 small text-muted">
										<span><i class="bi bi-clock me-1"></i> <%= tip.readTimeMinutes %> min</span>
										<% if (tip.impactKgCO2 > 0) { %>
											<span><i class="bi bi-cloud me-1"></i> -<%= tip.impactKgCO2 %> kg CO₂</span>
										<% } %>
										<% if (user) { %>
											<form action="/tip/<%= tip.id %>/favorite" method="POST" class="ms-auto d-inline">
												<button type="submit" class="btn btn-sm btn-link p-0 text-primary-green" title="Favoritar">
													<i class="bi bi-star"></i>
												</button>
											</form>
										<% } %>
									</div>
								</div>
							</div>
						<% }); %>
					<% } else { %>
						<div class="text-center text-muted py-5">
							<i class="bi bi-tree display-5 d-block mb-3"></i>
							Ainda não há dicas nesta categoria.
						</div>
					<% } %>
				</div>

				<!-- Coluna lateral -->
				<div class="col-lg-4">
					<!-- Posts recentes -->
					<div class="tip-card p-3">
						<h6 class="fw-bold mb-3">
							<i class="bi bi-people me-1"></i> Posts da comunidade
						</h6>
						<% if (recentPosts && recentPosts.length > 0) { %>
							<% recentPosts.forEach(function(post) { %>
								<div class="d-flex gap-2 align-items-start py-2 border-bottom" style="border-color:var(--line) !important;">
									<div class="post-avatar-circle" style="width:36px; height:36px; font-size:.9rem;">
										<%= post.author.fullName.charAt(0).toUpperCase() %>
									</div>
									<div class="flex-grow-1">
										<a href="/post/<%= post.id %>" class="text-decoration-none text-dark small fw-bold d-block text-truncate">
											<%= post.title %>
										</a>
										<small class="text-muted">por <%= post.author.fullName %></small>
									</div>
								</div>
							<% }); %>
							<a href="/community" class="d-block text-center mt-3 small text-primary-green text-decoration-none fw-bold">
								Ver todos →
							</a>
						<% } else { %>
							<p class="text-muted small mb-0">Ainda não há posts aqui.</p>
						<% } %>
					</div>
				</div>
			</div>
		</main>
	</div>
</div>
