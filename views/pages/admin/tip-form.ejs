<div class="container py-4" style="max-width:780px;">
	<a href="/admin/tips" class="text-muted text-decoration-none small mb-3 d-inline-block">
		<i class="bi bi-arrow-left me-1"></i> voltar
	</a>
	<div class="tip-card p-4">
		<h2 class="fw-bold mb-4">
			<%= tip ? 'Editar dica' : 'Nova dica' %>
		</h2>
		<form action="<%= tip ? '/admin/tips/' + tip.id + '/edit' : '/admin/tips/new' %>" method="POST" enctype="multipart/form-data">
			<div class="mb-3">
				<label class="form-label">Título</label>
				<input type="text" name="title" class="form-control" required maxlength="150"
					value="<%= tip ? tip.title : '' %>" />
			</div>
			<div class="mb-3">
				<label class="form-label">Resumo (até 255 caracteres)</label>
				<input type="text" name="summary" class="form-control" maxlength="255"
					value="<%= tip ? (tip.summary || '') : '' %>" />
			</div>
			<div class="row g-3 mb-3">
				<div class="col-md-6">
					<label class="form-label">Categoria</label>
					<select name="categoryId" class="form-control" required>
						<option value="">— Selecione —</option>
						<% categories.forEach(function(c) { %>
							<option value="<%= c.id %>" <%= tip && tip.categoryId === c.id ? 'selected' : '' %>>
								<%= c.name %>
							</option>
						<% }); %>
					</select>
				</div>
				<div class="col-md-3">
					<label class="form-label">Tempo de leitura (min)</label>
					<input type="number" name="readTimeMinutes" class="form-control" min="1"
						value="<%= tip ? tip.readTimeMinutes : 5 %>" />
				</div>
				<div class="col-md-3">
					<label class="form-label">Impacto (kg CO₂)</label>
					<input type="number" name="impactKgCO2" class="form-control" step="0.1" min="0"
						value="<%= tip ? tip.impactKgCO2 : 0 %>" />
				</div>
			</div>
			<div class="mb-3">
				<label class="form-label">Conteúdo</label>
				<textarea name="content" class="form-control" rows="10" required
					minlength="10" maxlength="5000"><%= tip ? tip.content : '' %></textarea>
				<small class="text-muted">Entre 10 e 5.000 caracteres.</small>
			</div>
			<div class="mb-4">
				<label class="form-label">Imagem (opcional)</label>
				<input type="file" name="image" class="form-control" accept="image/*" />
				<% if (tip && tip.image) { %>
					<small class="text-muted d-block mt-1">Atual: <%= tip.image %></small>
				<% } %>
			</div>
			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-primary btn-lg">Salvar</button>
				<a href="/admin/tips" class="btn btn-outline-secondary btn-lg">Cancelar</a>
			</div>
		</form>
	</div>
</div>
