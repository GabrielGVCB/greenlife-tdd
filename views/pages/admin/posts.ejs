<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="fw-bold mb-0">Moderação de posts</h1>
		<a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
	</div>

	<div class="tip-card p-0 overflow-hidden">
		<table class="table table-hover mb-0">
			<thead style="background: var(--bg-alt);">
				<tr>
					<th>Título</th>
					<th>Autor</th>
					<th>Privado?</th>
					<th>Data</th>
					<th class="text-end">Ações</th>
				</tr>
			</thead>
			<tbody>
				<% posts.forEach(function(p) { %>
					<tr>
						<td><a href="/post/<%= p.id %>" class="text-decoration-none text-dark"><%= p.title %></a></td>
						<td class="small">@<%= p.author.username %></td>
						<td>
							<% if (p.isPrivate) { %>
								<span class="badge bg-warning text-dark">Privado</span>
							<% } else { %>
								<span class="badge bg-success">Público</span>
							<% } %>
						</td>
						<td class="small text-muted"><%= new Date(p.createdAt).toLocaleDateString('pt-BR') %></td>
						<td class="text-end">
							<form action="/admin/posts/<%= p.id %>/delete" method="POST" class="d-inline">
								<button type="submit" class="btn btn-sm btn-outline-danger"
									onclick="return confirm('Remover post?');">
									<i class="bi bi-trash"></i>
								</button>
							</form>
						</td>
					</tr>
				<% }); %>
			</tbody>
		</table>
	</div>
</div>
