<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="fw-bold mb-0">Dicas oficiais</h1>
		<div>
			<a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
			<a href="/admin/tips/new" class="btn btn-primary btn-sm">
				<i class="bi bi-plus-circle me-1"></i> Nova dica
			</a>
		</div>
	</div>

	<div class="tip-card p-0 overflow-hidden">
		<table class="table table-hover mb-0">
			<thead style="background: var(--bg-alt);">
				<tr>
					<th>Título</th>
					<th>Categoria</th>
					<th>Autor</th>
					<th>Impacto</th>
					<th class="text-end">Ações</th>
				</tr>
			</thead>
			<tbody>
				<% tips.forEach(function(t) { %>
					<tr>
						<td><a href="/tip/<%= t.id %>" class="text-decoration-none text-dark"><%= t.title %></a></td>
						<td>
							<% if (t.category) { %>
								<span class="cat-chip"><%= t.category.name %></span>
							<% } %>
						</td>
						<td class="small text-muted"><%= t.author ? t.author.username : '-' %></td>
						<td class="small"><%= t.impactKgCO2 %> kg</td>
						<td class="text-end">
							<a href="/admin/tips/<%= t.id %>/edit" class="btn btn-sm btn-outline-primary">
								<i class="bi bi-pencil"></i>
							</a>
							<form action="/admin/tips/<%= t.id %>/delete" method="POST" class="d-inline">
								<button type="submit" class="btn btn-sm btn-outline-danger"
									onclick="return confirm('Excluir dica?');">
									<i class="bi bi-trash"></i>
								</button>
							</form>
						</td>
					</tr>
				<% }); %>
			</tbody>
		</table>
	</div>
</div>
