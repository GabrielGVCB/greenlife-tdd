<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="fw-bold mb-0">Usuários</h1>
		<a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
	</div>

	<div class="tip-card p-0 overflow-hidden">
		<table class="table table-hover mb-0">
			<thead style="background: var(--bg-alt);">
				<tr>
					<th>Usuário</th>
					<th>Nome</th>
					<th>E-mail</th>
					<th>Role</th>
					<th>Cadastrado em</th>
					<th class="text-end">Ações</th>
				</tr>
			</thead>
			<tbody>
				<% users.forEach(function(u) { %>
					<tr>
						<td>@<%= u.username %></td>
						<td><%= u.fullName %></td>
						<td class="small text-muted"><%= u.email %></td>
						<td>
							<% if (u.role === 'admin') { %>
								<span class="badge bg-success">admin</span>
							<% } else { %>
								<span class="badge bg-secondary">user</span>
							<% } %>
						</td>
						<td class="small text-muted"><%= new Date(u.createdAt).toLocaleDateString('pt-BR') %></td>
						<td class="text-end">
							<form action="/admin/users/<%= u.id %>/toggle-role" method="POST" class="d-inline">
								<button type="submit" class="btn btn-sm btn-outline-primary" title="Alternar role">
									<i class="bi bi-shield"></i>
								</button>
							</form>
							<form action="/admin/users/<%= u.id %>/delete" method="POST" class="d-inline">
								<button type="submit" class="btn btn-sm btn-outline-danger"
									onclick="return confirm('Excluir usuário <%= u.username %>?');">
									<i class="bi bi-trash"></i>
								</button>
							</form>
						</td>
					</tr>
				<% }); %>
			</tbody>
		</table>
	</div>
</div>
